# Loomix Mail - Production Configuration
# Copy this file to .env.local and fill in your values.
# For development with the built-in mock server, see .env.dev.example instead.

# #
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# Stalwart JMAP endpoint
JMAP_URL=https://mail.example.com

# Cerulean Authentik issuer
AUTHENTIK_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/loomix/

# Cerulean OIDC client id
AUTHENTIK_CLIENT_ID=loomix-mail

# Cerulean OIDC client secret
AUTHENTIK_CLIENT_SECRET=change-me

# Let heartbeats reach a private/loopback address. Off by default as an SSRF
# guard; only useful when running a collector locally during development.
# BULWARK_TELEMETRY_ALLOW_PRIVATE=1

# Stalwart version to report in heartbeats. Stalwart does not publish its
# version, so the heartbeat leaves it empty unless it is set here.
# STALWART_VERSION=0.16.23

# 